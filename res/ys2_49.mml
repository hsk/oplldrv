; _ (ポルタメント) のテスト
#opll_mode 0
#tempo 120

; 上げる・下げる・ブロックをまたぐ・長い音・短い音 (16 分音符は端数のフレーム)
9 @1 v15 o4 l8
9 c_e4 r4 e_c4 r4 d_<d4 >r4 c_>c2 r4 <c_c+8 r8 c_c+4 r4 c_<c1 >r4 l16 c_e c_e e_c8. r4

; スラーでつなぐ、q で切れたあとも動く、デチューン、ループの中
A @3 v13 o4 l8
A c4&c_e4 r4 c_e4&e4 r4 c_e4&f4 r4 q4 c_e4 r4 q8 \3 c_e4 \0 r4 [d_f8 f_d8]2 r4

; LFO と一緒に使う (ポルタメントの間は LFO を止め、終わったら目標の音程からやり直す)
B @5 v12 o4 l8
B h0,2,0,4 c_e4 r4 h0,2,0,40 c_e4 r4 h0,2,0,4 c4&c_e4 d4 h21,2,1,2 d4&d_<d8 ><agfe hf c_e4
