; h (ソフトウェア LFO) のテスト
#opll_mode 0
#tempo 120

; 遅れ・速さ・振れ幅を変える。音ごとにやり直す
9 @1 v15 o4 l8
9 h21,2,1,2 c1 h6,1,0,2 d2 e2 h0,1,0,1 f4 g4 h0,0,0,4 a4 h3,2,0,4 b4

; スラーでつなぐ (速さのタイマーは続ける)、休符・q で切れたあとも動く、hf で止めて ho で動かす
A @3 v13 o4 l8
A h0,2,1,4 c8&d8&e8 h3,2,0,4 c8&d8 q4 e4 f4 q8 g8 r8 a8 hf b8 >c8 ho d8 <h0,2,0,8 &e4

; 大きく動かしてブロックをまたぐ (音程を下げる効果)、デチューンと一緒に使う
B @5 v12 o4 l8
B h0,32,0,-16 c2 \-3 h0,4,0,24 d2 \0 h5,3,1,-8 e2 h0,3,0,0 f4

; ループの中で LFO を切り替える
C @7 v12 o5 l8
C [h0,2,0,4 c d hf e] [ho f g hf a]2 b

; 同じ音程をスラーでつなぐときは LFO をやり直さない (間で音量を変えても同じ)。音程が違えばやり直す
D @9 v12 o4 l8
D h0,2,0,4 c8&c8&c8 r4 c8&v10c8&v12c8 r4 c8&<c8 >r4 \2 c8&c8 \0 r4 h21,2,1,1 l16 b-&v+1b-&v+1b-&v+1b-8.&b-4 r4
