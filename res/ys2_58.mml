      9      g8.e8.c8

      9      <g8.>c8.e8
      9      fd<afda>df ec<gecg>ce<

      9      dfa>c+dfa

      9      @16 ;distortion guitar high
      9      >c+d2<<
      9      *v2

      ;**** part c
      ; elepi
      9      @19 q6so ;electric piano

      9     >
      9     fecd16^4^ 4<a>cdc
      9     fecd16^4^ 4<agfe

      9     f8.d8.f8
      9     g8.e8.g8
      9     a8.f8.d8
      9     e8.g8.b-8
      9     a2> defgagfe

      9     g8.e8.c8

      9     <g8.>c8.e8
      9     fd<afda>df ec<gecg>c
      9     e<

      ;**** part d
      9     @21 q8sf ;brass

      9     e-8.&<b-32&>e-32g8.&e-32&g32 b-8.&g32&b-32 >e-8&
      9    |e-8<

      9     >a4dfga16^ 8g8fg8>d&
      9     d8<a8gf8e16^ 8f8.g8.<

      ;**** part e
      9     @19 q6so ;electric piano

      9     >a4dfga16^  8g8fg8>d&
      9      d8d8e8d8 d4c+4<<

      ;**** part f
