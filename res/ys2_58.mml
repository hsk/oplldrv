    ;=============================================
      #macro_offset {v=0, h=4}
      9 r16 ;wait
      9    l16
      9    r8.
      9    *h0

      9    [

      9     v14 o4 

      ;**** part a
      9     *v0 ;distortion guitar
      9     e-ega8<aaa> c+<a>d<a>e<a>d
      9     <a>

      9     < @20 ;shtar
